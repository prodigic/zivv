
# Use bd merge for beads JSONL files
.beads/issues.jsonl merge=beads

# Keep source formatting checks consistent across Windows and Linux checkouts.
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf

# Manifest checksums describe exact served bytes on every platform.
public/data/*.json text eol=lf
data/ingestion/*.json text eol=lf
data/ingestion/reports/*.json text eol=lf

# Encrypted snapshots have no meaningful text diff or automatic merge.
data/ingestion/backups/*.enc binary

# Preserve byte-for-byte Census evidence and its recorded SHA-256 receipts.
data/research/venue-maps/census-*.csv -text
